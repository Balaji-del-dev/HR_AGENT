# Every variable the backend reads. Local development needs none of them:
# config/settings/dev.py defaults match scripts/setup_local_db.sql.
# In staging/production these come from Vault or AWS Secrets Manager.

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=hr.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://hr.example.com

# Runtime role: not the table owner, no BYPASSRLS.
DB_NAME=hr_platform
DB_USER=hr_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
# Role that receives DML grants after `migrate` (migrations run as the owner role).
DB_APP_ROLE=hr_app

REDIS_CACHE_URL=redis://127.0.0.1:6379/11
CELERY_BROKER_URL=redis://127.0.0.1:6379/12
CHANNELS_REDIS_URL=redis://127.0.0.1:6379/13

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

LOG_JSON=true
LOG_LEVEL=INFO

# --- Agents and LLMs ---------------------------------------------------------
# offline (deterministic, default in dev) | ollama (local) | anthropic (Claude)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_EFFORT=medium
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# ollama (all-minilm, 384 dims) | hash (offline)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=all-minilm
# auto uses pgvector when the extension is installed
VECTOR_BACKEND=auto
# presidio | patterns
PII_MASKER=presidio
AGENT_CHECKPOINTER=postgres
AGENT_MAX_TOOL_CALLS=80
AGENT_MAX_TOKENS=400000

# --- Documents ----------------------------------------------------------------
OBJECT_STORAGE_ROOT=/var/lib/hr-platform/objects
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_MAX_PAGES=20
CLAMAV_SOCKET=/var/run/clamav/clamd.ctl

# --- Policy, tracing ----------------------------------------------------------
OPA_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://langfuse.example.com
